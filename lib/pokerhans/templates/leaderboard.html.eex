<div class="mb-6">
    <div class="mb-6">
        <p class="text-sm font-semibold uppercase tracking-wide text-poker-green">Pokerhans</p>
        <h2 class="text-3xl font-bold text-gray-900">Rangliste</h2>
    </div>

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">


        <section class="bg-white rounded-lg shadow-sm ring-1 ring-gray-900/5 overflow-hidden">
            <div class="border-b border-gray-100 px-5 py-4">
                <h3 class="text-xl font-bold text-gray-900">Siege gesamt</h3>
                <p class="mt-1 text-sm text-gray-600">Alle Siege über alle Saisons.</p>
            </div>

            <%= if present?(@data.overall_wins) do %>
            <ol>
                <%= for item1 <- @data.overall_wins do %>
                <li class="flex items-center gap-3 px-5 py-3 border-b border-gray-100 last:border-b-0 hover:bg-gray-50/70 transition-colors">
                    <span class="inline-flex items-center justify-center w-8 h-8 rounded text-xs font-bold tabular-nums shrink-0
                        <%= if present?(item1.rank == 1) do %>bg-yellow-100 text-yellow-800 ring-1 ring-yellow-300
                        <% else %><%= if present?(item1.rank == 2) do %>bg-gray-100 text-gray-700 ring-1 ring-gray-300
                        <% else %><%= if present?(item1.rank == 3) do %>bg-orange-100 text-orange-800 ring-1 ring-orange-300
                        <% else %>bg-poker-green/10 text-poker-green<% end %><% end %><% end %>">
                        <%= item1.rank %>
                    </span>
                    <span class="flex-1 font-medium text-gray-900 truncate"><%= item1.player_name %></span>
                    <span class="tabular-nums font-semibold text-gray-900">
                        <%= item1.wins %> <span class="text-gray-500 font-normal"><%= if present?(item1.wins == 1) do %>Sieg<% else %>Siege<% end %></span>
                    </span>
                </li>
                <% end %>
            </ol>
            <% else %>
            <p class="p-4 text-gray-500 italic">Noch keine Siege erfasst.</p>
            <% end %>
        </section>


        <section class="bg-white rounded-lg shadow-sm ring-1 ring-gray-900/5 overflow-hidden">
            <div class="border-b border-gray-100 px-5 py-4">
                <h3 class="text-xl font-bold text-gray-900">Wertung seit Saison <%= @data.leaderboard_start_season %></h3>
                <p class="mt-1 text-sm text-gray-600">Punktesystem: Sieg 3 Punkte, zweiter Platz 1 Punkt.</p>
            </div>

            <%= if present?(@data.points_leaderboard) do %>
            <ol>
                <%= for item2 <- @data.points_leaderboard do %>
                <li class="flex items-center gap-3 px-5 py-3 border-b border-gray-100 last:border-b-0 hover:bg-gray-50/70 transition-colors">
                    <span class="inline-flex items-center justify-center w-8 h-8 rounded text-xs font-bold tabular-nums shrink-0
                        <%= if present?(item2.rank == 1) do %>bg-yellow-100 text-yellow-800 ring-1 ring-yellow-300
                        <% else %><%= if present?(item2.rank == 2) do %>bg-gray-100 text-gray-700 ring-1 ring-gray-300
                        <% else %><%= if present?(item2.rank == 3) do %>bg-orange-100 text-orange-800 ring-1 ring-orange-300
                        <% else %>bg-poker-green/10 text-poker-green<% end %><% end %><% end %>">
                        <%= item2.rank %>
                    </span>

                    <div class="flex-1 min-w-0">
                        <div class="font-medium text-gray-900 truncate"><%= item2.player_name %></div>
                        <div class="mt-1 text-xs text-gray-500 tabular-nums">
                            <%= item2.wins %> <%= if present?(item2.wins == 1) do %>Sieg<% else %>Siege<% end %> ·
                            <%= item2.seconds %> <%= if present?(item2.seconds == 1) do %>zweiter Platz<% else %>zweite Plätze<% end %>
                        </div>
                    </div>

                    <div class="text-right shrink-0">
                        <div class="text-2xl font-bold text-gray-900 tabular-nums leading-none"><%= item2.points %></div>
                        <div class="text-[10px] uppercase tracking-wider text-gray-500 mt-0.5">Punkte</div>
                    </div>
                </li>
                <% end %>
            </ol>
            <% else %>
            <p class="p-4 text-gray-500 italic">Noch keine Wertungen seit Saison <%= @data.leaderboard_start_season %> erfasst.</p>
            <% end %>
        </section>
    </div>
</div>
